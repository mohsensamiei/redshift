                Vision(range: 1200),
                PowerDraw(amount: 50, works_unpowered: false),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 1000,
                    build_time: 50,
                    prerequisites: ["soviet_refinery"],
                    produced_by: "soviet_construction_yard",
