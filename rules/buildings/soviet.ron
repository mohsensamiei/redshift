                Capturable,
                Selectable(priority: 4),
                Buildable(
                    cost: 500,
                    build_time: 25,
                    prerequisites: ["soviet_barracks"],
                    produced_by: "soviet_construction_yard",
                ),
            ],
        ),
        (
            // Troopers standing at it make it stronger, and three of them cut
            // it loose from the power grid entirely. That last part is the
