// Allied structures.
//
// A structure differs from a unit only in the traits it carries — a Footprint,
// no Mobile, usually a PowerDraw. There is no separate building type.
(
    entities: [
        (
            id: "construction_yard",
            name_key: "building.construction_yard",
            side: "allied",
            category: "structure",
            traits: [
                Health(max: 1000, armour: "concrete"),
                Footprint(width: 3, height: 3),
                Vision(range: 500),
                Produces(categories: ["structure"]),
                Capturable,
                Selectable(priority: 5),
                // Packs back up into the vehicle it came from. The pair is
                // symmetric on purpose: one command, whichever way it goes.
                Deploys(into: "mcv"),
            ],
        ),
        (
            id: "power_plant",
            name_key: "building.power_plant",
            side: "allied",
            category: "structure",
            traits: [
                Health(max: 400, armour: "concrete"),
                Footprint(width: 2, height: 2),
                Vision(range: 300),
                PowerSupply(output: 100),
                // A minute in the dark, at twenty ticks a second.
                Infiltrated(effect: Blackout(ticks: 1200)),
                Explodes(warhead: "explosive", damage: 120),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 300,
                    build_time: 30,
                    prerequisites: ["construction_yard"],
                    produced_by: "construction_yard",
                ),
            ],
        ),
        (
            id: "barracks",
            name_key: "building.barracks",
            side: "allied",
            category: "structure",
            traits: [
                Health(max: 500, armour: "concrete"),
                Footprint(width: 2, height: 2),
                Vision(range: 300),
                PowerDraw(amount: 20, works_unpowered: true),
                Produces(categories: ["infantry"]),
                // A spy here promotes every soldier you build from then on —
                // and only soldiers. The war factory carries the vehicle row.
                Infiltrated(effect: Promotes(category: "infantry")),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 500,
                    build_time: 35,
                    prerequisites: ["power_plant"],
                    produced_by: "construction_yard",
                ),
            ],
        ),
        (
            id: "ore_purifier",
            name_key: "building.ore_purifier",
            side: Some("allied"),
            category: "structure",
            traits: [
                Health(max: 700, armour: "concrete"),
                // A quarter more from every load, for as long as it stands.
                // Researched: docs/08-roster.md.
                Grants(effect: OreValue(125)),
                Vision(range: 400),
                Footprint(width: 3, height: 3),
                PowerDraw(amount: 200, works_unpowered: false),
                Buildable(
                    cost: 2500,
                    build_time: 100,
                    prerequisites: ["refinery"],
                    produced_by: "construction_yard",
                ),
            ],
        ),
        (
            id: "refinery",
            name_key: "building.refinery",
            side: "allied",
            category: "structure",
            traits: [
                // Arrives with a harvester. Researched: this is why a refinery
                // is the first thing built, and an economy balanced without it
                // would be wrong from the start.
                Delivers(units: ["harvester"]),
                Health(max: 900, armour: "concrete"),
                Footprint(width: 3, height: 2),
                Vision(range: 350),
                // A refinery keeps refining in a shortage: the original degrades an
                // economy rather than stopping it dead.
                PowerDraw(amount: 30, works_unpowered: true),
                Refinery(value_per_unit: 25),
                // The researched figure: a spy takes a fifth of what the victim
                // is holding.
                Infiltrated(effect: StealsFunds(percent: 20)),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 2000,
                    build_time: 60,
                    prerequisites: ["power_plant"],
                    produced_by: "construction_yard",
                ),
            ],
        ),
        (
            id: "war_factory",
            name_key: "building.war_factory",
            side: "allied",
            category: "structure",
            traits: [
                Health(max: 1000, armour: "concrete"),
                Footprint(width: 3, height: 3),
                Vision(range: 350),
                PowerDraw(amount: 50, works_unpowered: true),
                Produces(categories: ["vehicle"]),
                Infiltrated(effect: Promotes(category: "vehicle")),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 2000,
                    build_time: 70,
                    prerequisites: ["refinery"],
                    produced_by: "construction_yard",
                ),
            ],
        ),
        (
            // Costs and power draw are the researched figures. The repair
            // rate and the price of a repair are not — see TODO.md.
            id: "service_depot",
            name_key: "building.service_depot",
            side: "allied",
            category: "structure",
            traits: [
                Health(max: 1000, armour: "concrete"),
                Footprint(width: 3, height: 3),
                Vision(range: 350),
                PowerDraw(amount: 20, works_unpowered: false),
                Repairs(
                    categories: ["vehicle"],
                    rate: 5,
                    cost_percent: 20,
                    cures_infestation: true,
                ),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 800,
                    build_time: 30,
                    prerequisites: ["war_factory"],
                    produced_by: "construction_yard",
                ),
            ],
        ),
    ],
)
