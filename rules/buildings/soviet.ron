                Vision(range: 350),
                PowerDraw(amount: 50, works_unpowered: true),
                Refinery(value_per_unit: 100),
                Delivers(units: ["war_miner"]),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 2000,
                    build_time: 60,
                    prerequisites: ["soviet_construction_yard"],
                    produced_by: "soviet_construction_yard",
                ),
            ],
        ),
