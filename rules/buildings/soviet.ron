            id: "tesla_coil",
            name_key: "building.tesla_coil",
            side: "soviet",
            category: "structure",
            traits: [
                Health(max: 600, armour: "concrete"),
                Vision(range: 700),
                Armed(weapon: "tesla_bolt", turret: true, turret_rate: 3600),
                PowerDraw(amount: 75, works_unpowered: false),
                Supported(
                    by: ["tesla_trooper"],
                    radius: 300,
                    bonus_percent: 40,
                    max_supporters: 3,
                    self_powered_at: 3,
                ),
                Capturable,
                Selectable(priority: 4),
                Buildable(
                    cost: 1500,
                    build_time: 60,
                    prerequisites: ["soviet_radar"],
                    produced_by: "soviet_construction_yard",
                ),
            ],
        ),
        (
            id: "flak_cannon_tower",
            name_key: "building.flak_cannon",
