// Soviet structures.
//
// The mirror of the Allied file, with the differences the original draws: a
// Tesla Coil where the Allies have a Prism Tower, a Nuclear Reactor that is
// worth destroying rather than merely worth having, and no Gap Generator.
//
// Costs and power figures are the researched ones from docs/08-roster.md.
// Weapon and rate figures are not — they are flagged in TODO.md with the rest.
(
    entities: [
        (
            id: "soviet_construction_yard",
            name_key: "building.construction_yard",
            side: "soviet",
            category: "structure",
            traits: [
                Health(max: 1000, armour: "concrete"),
                Footprint(width: 3, height: 3),
                Vision(range: 500),
                Produces(categories: ["structure"]),
                Capturable,
                Selectable(priority: 5),
                Deploys(into: "soviet_mcv"),
            ],
        ),
        (
            // A Tesla Reactor supplies more than an Allied plant and costs
            // more. The Soviets pay for power up front and the Allies pay in
            // building count, which is the shape of the difference.
            id: "tesla_reactor",
            name_key: "building.tesla_reactor",
            side: "soviet",
            category: "structure",
            traits: [
                Health(max: 400, armour: "concrete"),
                Footprint(width: 2, height: 2),
                Vision(range: 300),
                PowerSupply(output: 150),
                Explodes(warhead: "explosive", damage: 140),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 600,
                    build_time: 40,
                    prerequisites: ["soviet_construction_yard"],
                    produced_by: "soviet_construction_yard",
                ),
            ],
        ),
        (
            // The reason a Soviet base is dangerous to stand in when it loses.
            // A blast *and* ground that stays contaminated afterwards — two
            // consequences of one death, and the second is what makes the
            // wreckage matter for the rest of the match.
            id: "nuclear_reactor",
            name_key: "building.nuclear_reactor",
            side: "soviet",
            category: "structure",
            traits: [
                Health(max: 750, armour: "concrete"),
                Footprint(width: 3, height: 3),
                Vision(range: 300),
                PowerSupply(output: 2000),
                Explodes(warhead: "explosive", damage: 400),
                Contaminates(
                    radius: 400,
                    damage: 8,
                    warhead: "radiation",
                    lingers: 400,
                    when: OnDeath,
                ),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 1000,
                    build_time: 60,
                    prerequisites: ["soviet_radar"],
                    produced_by: "soviet_construction_yard",
                ),
            ],
        ),
        (
            id: "soviet_barracks",
            name_key: "building.soviet_barracks",
            side: "soviet",
            category: "structure",
            traits: [
                Health(max: 500, armour: "concrete"),
                Footprint(width: 3, height: 2),
                Vision(range: 300),
                PowerDraw(amount: 20, works_unpowered: false),
                Produces(categories: ["infantry"]),
                Capturable,
                Selectable(priority: 5),
                Buildable(
                    cost: 500,
                    build_time: 40,
                    prerequisites: ["soviet_construction_yard"],
                    produced_by: "soviet_construction_yard",
                ),
            ],
        ),
        (
            id: "soviet_refinery",
            name_key: "building.refinery",
            side: "soviet",
